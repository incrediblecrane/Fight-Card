"tag":"Meal prep","prep":true,"base":6,"macros":[190,16,4,12],"ingredients":["Eggs (12)","Spinach (150g)","Peppers (2)","Cheddar cheese (80g)","Spring onion (4)","Milk (60ml)","Salt and pepper"],"instructions":"Wilt the spinach and squeeze it dry, dice the peppers, divide between a greased 12-hole muffin tin, pour over the beaten eggs and milk, bake 20 min at 180C. Two per portion. The one prep breakfast that is genuinely quick to reheat: 30 seconds from cold. Squeezing the spinach matters, or they weep water in the fridge.","portions":6,"inPlan":false,"day":"Unassigned","_ings":[{"n":"Eggs","q":12,"u":"","d":"","raw":"Eggs (12)"},{"n":"Spinach","q":150,"u":"g","d":"","raw":"Spinach (150g)"},{"n":"Peppers","q":2,"u":"","d":"","raw":"Peppers (2)"},{"n":"Cheddar cheese","q":80,"u":"g","d":"","raw":"Cheddar cheese (80g)"},{"n":"Spring onion","q":4,"u":"","d":"","raw":"Spring onion (4)"},{"n":"Milk","q":60,"u":"ml","d":"","raw":"Milk (60ml)"},{"n":"Salt and pepper","q":null,"u":"","raw":"Salt and pepper"}]}],"uiTab":"today","uiViewingSession":false,"uiSlide":0,"saunaSessions":[],"uiProgRange":14,"plan":[],"shopExtras":[]}