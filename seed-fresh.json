n":"Pumpkin seeds","q":null,"u":"","raw":"Pumpkin seeds"}]},{"id":"p1","title":"Chicken & chorizo one-pan rice","tag":"Meal prep","prep":true,"base":5,"macros":[620,42,62,20],"ingredients":["Chicken thighs, boneless (900g)","Chorizo (150g)","Long-grain rice (400g)","Chicken stock (900ml)","Peppers (3)","Onion (2)","Garlic (4 cloves)","Smoked paprika (2 tsp)","Chopped tomatoes (1 tin)","Olive oil"],"instructions":"Brown the chicken and chorizo, set aside. Soften onion, pepper and garlic, add paprika and rice and stir for a minute. Add tomatoes and stock, return the meat, simmer covered 20-25 min until the rice is done. Reheats better than almost anything: the rice keeps absorbing sauce. Cool it fast, fridge within the hour, eat within a day given the rice.","portions":5,"inPlan":false,"day":"Unassigned","_ings":[{"n":"Chicken thighs, boneless","q":900,"u":"g","d":"","raw":"Chicken thighs, boneless (900g)"},{"n":"Chorizo","q":150,"u":"g","d":"","raw":"Chorizo (150g)"},{"n":"Long-grain rice","q":400,"u":"g","d":"","raw":"Long-grain rice (400g)"},{"n":"Chicken stock","q":900,"u":"ml","d":"","raw":"Chicken stock (900ml)"},{"n":"Peppers","q":3,"u":"","d":"","raw":"Peppers (3)"},{"n":"Onion","q":2,"u":"","d":"","raw":"Onion (2)"},{"n":"Garlic","q":4,"u":"cloves","d":"","raw":"Garlic (4 cloves)"},{"n":"Smoked paprika","q":2,"u":"tsp","d":"","raw":"Smoked paprika (2 tsp)"},{"n":"Chopped tomatoes","q":1,"u":"tin","d":"","raw":"Chopped tomatoes (1 tin)"},{"n":"Olive oil","q":null,"u":"","raw":"Olive oil"}]},{"id":"p2","title":"Beef chilli con carne","tag":"Meal prep","prep":true,"base":5,"macros":[540,38,48,20],"ingredients":["Beef mince, 5% fat (750g)","Kidney beans (2 tins)","Chopped tomatoes (2 tins)","Onion (2)","Peppers (2)","Garlic (4 cloves)","Beef stock (300ml)","Cumin (2 tsp)","Smoked paprika (2 tsp)","Chilli powder (1 tsp)","Dark chocolate (10g)"],"instructions":"Brown the mince hard, add onion, pepper, garlic and spices, then tomatoes, beans and stock. Simmer 40 min uncovered until thick, stir in the chocolate. Better on day two. Freezes well; portion the rice separately so you are not reheating it twice.","portions":5,"inPlan":false,"day":"Unassigned","_ings":[{"n":"Beef mince, 5% fat","q":750,"u":"g","d":"","raw":"Beef mince, 5% fat (750g)"},{"n":"Kidney beans","q":2,"u":"tins","d":"","raw":"Kidney beans (2 tins)"},{"n":"Chopped tomatoes","q":2,"u":"tins","d":"","raw":"Chopped tomatoes (2 tins)"},{"n":"Onion","q":2,"u":"","d":"","raw":"Onion (2)"},{"n":"Peppers","q":2,"u":"","d":"","raw":"Peppers (2)"},{"n":"Garlic","q":4,"u":"cloves","d":"","raw":"Garlic (4 cloves)"},{"n":"Beef stock","q":300,"u":"ml","d":"","raw":"Beef stock (300ml)"},{"n":"Cumin","q":2,"u":"tsp","d":"","raw":"Cumin (2 tsp)"},{"n":"Smoked paprika","q":2,"u":"tsp","d":"","raw":"Smoked paprika (2 tsp)"},{"n":"Chilli powder","q":1,"u":"tsp","d":"","raw":"Chilli powder (1 tsp)"},{"n":"Dark chocolate","q":10,"u":"g","d":"","raw":"Dark chocolate (10g)"}]},{"id":"p3","title":"Turkey bolognese","tag":"Meal prep","prep":true,"base":5,"macros":[520,40,55,14],"ingredients":["Turkey mince (750g)","Chopped tomatoes (2 tins)","Tomato puree (2 tbsp)","Onion (2)","Carrot (2)","Celery (2 sticks)","Garlic (4 cloves)","Beef or chicken stock (300ml)","Mixed herbs (2 tsp)","Olive oil"],"instructions":"Soften the onion, carrot and celery slowly, brown the mince, add puree, tomatoes, stock and herbs, simmer 45 min. Store the sauce on its own and cook pasta fresh: pasta left sitting in sauce keeps softening and is the usual reason a batch bolognese is disappointing by Wednesday.","portions":5,"inPlan":false,"day":"Unassigned","_ings":[{"n":"Turkey mince","q":750,"u":"g","d":"","raw":"Turkey mince (750g)"},{"n":"Chopped tomatoes","q":2,"u":"tins","d":"","raw":"Chopped tomatoes (2 tins)"},{"n":"Tomato puree","q":2,"u":"tbsp","d":"","raw":"Tomato puree (2 tbsp)"},{"n":"Onion","q":2,"u":"","d":"","raw":"Onion (2)"},{"n":"Carrot","q":2,"u":"","d":"","raw":"Carrot (2)"},{"n":"Celery","